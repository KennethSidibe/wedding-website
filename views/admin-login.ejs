<!doctype html>
<html lang="en">

    <%- include ("header.ejs") %>

    <!-- Styles -->
    <link rel="stylesheet" href="/styles/admin.css" />
    <!-- Styles -->

  <body>

    <%- include('navbar.ejs') %>

    <div
      class="container g-form d-flex flex-column align-items-center justify-content-center"
    >
      <div class="container mb-5">
        <div class="row align-self-start">
          <div class="col d-flex justify-content-center align-items-center">
            <h2 class="double-word">Espace des Mariés</h2>
          </div>
        </div>
      </div>
      <div
        class="container form-img d-flex justify-content-center align-items-center flex-column px-3 form-style"
      >

        <% if (locals.locked) { %>
        <div class="row text-center mb-4 login-error">
          L'accès est verrouillé suite à un trop grand nombre d'essais.
          Veuillez contacter le développeur pour le déverrouiller.
        </div>
        <% } else if (locals.errorMessage) { %>
        <div class="row text-center mb-4 login-error"><%= errorMessage %></div>
        <% } %>

        <form id="adminLoginForm" method="post" action="/admin/login">
          <div class="mb-3 pin">
            <label for="pinInput" class="form-label" id="pin-label">Code PIN</label>
            <input
              placeholder="••••••"
              type="password"
              inputmode="numeric"
              autocomplete="off"
              class="form-control"
              id="pinInput"
              name="pin"
              <% if (locals.locked) { %>disabled<% } %>
            />
          </div>

          <div class="row">
            <div class="col d-flex justify-content-center">
              <button
                type="submit"
                id="loginBtn"
                class="btn btn-light"
                <% if (locals.locked) { %>disabled<% } %>
              >
                Se connecter
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <%- include("footer.ejs") %>

  </body>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"
  ></script>
</html>
