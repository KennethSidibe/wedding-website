<%
  // The map-link control for one programme entry. Edit mode only.
  //
  // A partial because the left- and right-hand entries render it either side
  // of the place text — left reads "place, link", right reads "link, place" —
  // and two copies of this markup would drift apart.
  //
  // Needs `mapKey` and `hasMap` passed in; `slotUrl` comes from res.locals.
  //
  // A labelled button, not an icon alone: an icon was too easy to miss next to
  // body copy and could not say which of its two states it was in without a
  // hover. The label carries the state in words, the tick and the fill repeat
  // it, so it never depends on colour alone.
%>
<button
  type="button"
  class="ls-map-btn<%= hasMap ? ' has-link' : '' %>"
  data-map-slot="<%= mapKey %>"
  data-map-value="<%- slotUrl(mapKey) %>"
>
  <span class="ls-map-btn-icon" aria-hidden="true">
    <%# A folded map, not the pin used for the place itself: the two sit side
        by side, so the same glyph twice would read as one repeated thing. %>
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
      <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.598-.49L10.5.99 5.598.01a.5.5 0 0 0-.196 0l-5 1A.5.5 0 0 0 0 1.5v14a.5.5 0 0 0 .598.49l4.902-.98 4.902.98a.5.5 0 0 0 .196 0l5-1A.5.5 0 0 0 16 14.5zM5 14.09V1.11l.5-.1.5.1v12.98l-.402-.08a.5.5 0 0 0-.196 0zm5 .8V1.91l.402.08a.5.5 0 0 0 .196 0L11 1.91v12.98l-.5.1z"/>
    </svg>
  </span>
  <span class="ls-map-btn-label"><%= hasMap ? 'Lien Maps ajouté' : 'Ajouter le lien Maps' %></span>
  <span class="ls-map-btn-tick" aria-hidden="true"<%= hasMap ? '' : ' hidden' %>>
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
      <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
    </svg>
  </span>
</button>
