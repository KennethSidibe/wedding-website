<!doctype html>
<html lang="en">
  
    <%- include ("header.ejs") %>

    <!-- Styles -->
    <link rel="stylesheet" href="/styles/invites.css" />
    <!-- Styles -->

  <body>
    
    <%- include('navbar.ejs') %>

    <div
      class="container g-form d-flex flex-column align-items-center justify-content-center"
    >
      <div class="container mb-5">
        <div class="row align-self-start">
          <div class="col d-flex justify-content-center align-items-center">
            <h2 class="double-word">Inscription des Invités</h2>
          </div>
        </div>
        <div class="container">
          
        </div>
      </div>
      <div
        class="container form-img d-flex justify-content-center align-items-center flex-column px-3 form-style"
      >

      <div id="emailErrorMsg" class="row text-center mb-4 hide">Email already exists, Retry</div>
        <form id="inviteesRegisterForm" method="post" action="/invitee">
          <div class="mb-3 nom">
            <label for="lastNameInput" class="form-label">Nom</label>
            <input
              placeholder="Rodrigue"
              type="text"
              class="form-control"
              id="lastNameInput"
              name="lastName"
              value=""
            />
            <div id="lastNameError" class="hide form-text error fw-medium"></div>
          </div>
          <div class="mb-3 prenom">
            <label for="firstNameInput" class="form-label">Prénom</label>
            <input
              placeholder="Kabore"
              type="text"
              class="form-control"
              id="firstNameInput"
              name="firstName"
              value=""
            />
            <div id="firstNameError" class="hide form-text error fw-medium"></div>
          </div>
          <div class="mb-3 email">
            <label
              for="emailInput"
              class="form-label"
              id="email-label"
              >Addresse e-mail</label
            >
            <input
              placeholder="kaborerodrigue@gmail.com"
              type="email"
              class="form-control"
              id="emailInput"
              name="email"
              value=""
            />
            <div id="emailError" class="hide form-text error fw-medium"></div>
          </div>

          <div class="row">
            <div class="col d-flex justify-content-center">
              <button type="button" id="submitFormBtn" class="btn btn-light">Soumettre</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <%- include("footer.ejs") %>
    
  </body>

  <!-- JQuery CDN -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <!-- JQuery CDN -->


  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"
  ></script>
  <script type="module" src="js/validate-invitees-register.js"></script>
</html>
