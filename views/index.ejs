                  <div class="price">+</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col pe-sm-4 d-flex justify-content-end pb-3">
          <div
            class="container m-0 d-flex justify-content-center align-items-end bg-img food"
          >
            <div class="container gx-2 gift-text-v2 mb-4">
              <div class="row">
                <div class="col-12 mb-2">
                  <div class="text-center">Buffet</div>
                </div>
              </div>

              <div
                class="row mx-1 justify-content-between align-items-center pb-2"
              >
                <div class="col text-center">
                  <div class="price">+</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col ps-sm-4 d-flex justify-content-start pb-3">
          <div
            class="container m-0 d-flex justify-content-center align-items-end bg-img planner"
          >
            <div class="container gx-2 gift-text-v2 mb-4">
              <div class="row">
                <div class="col-12 mb-2">
