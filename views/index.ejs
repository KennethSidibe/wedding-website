                <div class="col text-center">
                  <div class="price">+</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row mt-4 text-center">
        <div class="col">
          <a href="/give"
            ><button class="btn fs-3 btn-dark give-btn">Offrir</button></a
