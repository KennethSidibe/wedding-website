<!doctype html>
<html lang="en">
  <%-include("header.ejs") %>
  <!-- Page styling -->
  <link rel="stylesheet" href="/styles/home.css" />
  <!-- Styles -->

  <body class="<%= typeof editMode !== 'undefined' && editMode ? 'ls-edit-mode' : '' %>">
    <% if (typeof editMode !== 'undefined' && editMode) { %>
    <%- include("edit-bar.ejs", { editPage: 'home', editPageLabel: 'Accueil' }) %>
    <% } %>

    <%- include("navbar.ejs") %>

    <% if (typeof registered !== 'undefined' && registered) { %>
    <div id="registerToast" class="register-toast" role="status" aria-live="polite">
      <button
        type="button"
        id="registerToastClose"
        class="register-toast-close"
        aria-label="Fermer"
      >
        &times;
      </button>

      <div class="register-toast-body">
        <h3 class="register-toast-title">Merci!</h3>
        <p class="register-toast-text">
          Merci de t'être enregistré, on t'attend avec impatience&nbsp;!
        </p>
      </div>

      <div class="register-toast-progress">
        <span class="register-toast-progress-bar"></span>
      </div>
    </div>
    <% } %>

    <div id="intro" class="section">
      <%
        // The two dates sit in the bottom-right of the photo, stacked and
        // right-aligned, inset from the corner rather than flush against it.
        //
        // The wrapper is a plain div, not a Bootstrap `.row`: `.row` carries
        // negative horizontal margins that would pull the block back out past
        // the inset this layout depends on.
      %>
      <div
        class="img-container d-flex justify-content-end align-items-end"
        data-img-slot="home.hero.image"
        data-img-var="--ls-hero-image"
        data-img-value="<%= imgSrc('home.hero.image') %>"
      >
        <div class="dates-row">
          <div class="dates-row-item">
            <h2 class="date-title"><%- slot('home.hero.date1') %></h2>
            <h4 class="location-title"><%- slot('home.hero.location1') %></h4>
          </div>
          <div class="dates-row-item">
            <h2 class="date-title"><%- slot('home.hero.date2') %></h2>
            <h4 class="location-title"><%- slot('home.hero.location2') %></h4>
          </div>
        </div>
      </div>
    </div>

    <div id="mariage" class="section">
      <div class="container left-text my-3">
        <div class="row section-title">
          <div class="col text-center mb-sm-4">
            <h2 class="double-word"><%- slot('home.mariage.title') %></h2>
          </div>
        </div>

        <div class="row justify-content-evenly align-items-end mx-auto">
          <div class="col-md border-f pb-4 pb-lg-0 col-lg-4">
            <p class="text-align-left mt-2 section-text">
              <%- slot('home.mariage.text') %>
            </p>
                  <div class="row mt-4 mb-3 text-center">
        <div class="col">
          <a href="/invitees"
            ><button
              class="btn fs-3 btn-dark give-btn"
              data-color-slots="site.button.bg|site.button.text"
            ><%- slot('home.mariage.button') %></button></a
          >
        </div>
      </div>

            <div
              class="border-strip"
              data-img-slot="home.mariage.strip"
              data-img-var="--ls-strip-image"
              data-img-value="<%= imgSrc('home.mariage.strip') %>"
              style="--ls-strip-image: url('<%= imgSrc('home.mariage.strip') %>')"
            ></div>
          </div>
          <div class="col-lg-6 border-v d-flex justify-content-center">
            <img
              src="<%= imgSrc('home.mariage.image') %>"
              data-img-slot="home.mariage.image"
              class="img-fluid couple-img"
              alt=""
            />
          </div>
        </div>
      </div>

      <div id="gift" class="container right-text my-3 mt-5">
        <a class="anchor" id="gift-anchor"></a>
        <div class="row">
          <div class="col text-center mt-sm-4 mb-md-3">
            <h2 class="double-word"><%- slot('home.gift.title') %></h2>
          </div>
        </div>

        <div class="row justify-content-evenly align-items-end mx-auto">
          <div
            class="col-lg-6 d-flex justify-content-sm-center justify-content-lg-start border-v left order-2 order-sm-1"
          >
            <img
              src="<%= imgSrc('home.gift.image') %>"
              data-img-slot="home.gift.image"
              class="img-fluid couple-img"
              alt=""
            />
          </div>

          <div
            class="col-md border-f right col-lg-4 pb-4 pb-lg-0 order-1 order-sm-2"
          >
            <p class="text mt-2 section-text">
              <%- slot('home.gift.text') %>
            </p>

            <div
              class="border-strip"
              data-img-slot="home.gift.strip"
              data-img-var="--ls-strip-image"
              data-img-value="<%= imgSrc('home.gift.strip') %>"
              style="--ls-strip-image: url('<%= imgSrc('home.gift.strip') %>')"
            ></div>
          </div>
        </div>
      </div>

      <div class="row mt-4 text-center">
        <div class="col">
          <p class="offer-cta mb-3">
            <%- slot('home.gift.cta') %>
          </p>
          <a href="/give"
            ><button
              class="btn fs-3 btn-dark give-btn"
              data-color-slots="site.button.bg|site.button.text"
            ><%- slot('home.gift.button') %></button></a
          >
        </div>
      </div>
    </div>

    

    <div class="program-section">
      <div class="row text-center">
        <h2 class="single-word"><%- slot('home.program.title') %></h2>
        <a class="anchor" id="program-anchor"></a>
      </div>

      <%
        // Two ceremonies, two timelines, one at a time.
        //
        // Both panels are always rendered; the tabs below just switch which one
        // is visible, so a guest can compare them without a page load. In edit
        // mode each panel additionally renders its whole pool of entries and
        // hides the ones past its count, so adding an entry is a matter of
        // revealing markup the server already produced — the editor never
        // rebuilds this design in JavaScript.
        //
        // Sides alternate by position, not by content: entry 1 is left, 2 is
        // right, and so on. That is what makes removal work — shifting the
        // values up one slot leaves the zig-zag intact automatically.
      %>
      <div class="row text-center program-tabs-row">
        <div class="col">
          <div class="program-tabs" role="tablist" aria-label="Choisir la cérémonie">
            <% programLocations.forEach(function (location, index) { %>
            <button
              type="button"
              class="program-tab<%= index === 0 ? ' is-active' : '' %>"
              role="tab"
              aria-selected="<%= index === 0 ? 'true' : 'false' %>"
              aria-controls="program-panel-<%= location.id %>"
              data-program-tab="<%= location.id %>"
            ><%= location.label %></button>
            <% }); %>
          </div>
        </div>
      </div>

      <% programLocations.forEach(function (location, locationIndex) { %>
      <div
        class="program-panel<%= locationIndex === 0 ? ' is-active' : '' %>"
        id="program-panel-<%= location.id %>"
        role="tabpanel"
        data-program-panel="<%= location.id %>"
      >
        <% const rendered = editMode ? maxProgramItems : location.count; %>
        <% for (let i = 1; i <= rendered; i++) { %>
        <%
          const isLeft = i % 2 === 1;
          const beyondCount = i > location.count;
          const prefix = `home.program.${location.id}.item${i}`;
        %>
        <div
          class="row program-row <%= isLeft ? 'left' : 'right' %><%= beyondCount ? ' ls-program-hidden' : '' %>"
          style="position: relative"<% if (editMode) { %> data-program-row="<%= i %>" data-program-loc="<%= location.id %>"<% } %>>
          <div class="col">
            <div class="vertical-line-v2"></div>
            <div class="circle-line"></div>
            <div class="circle-dash<%= isLeft ? '' : ' right' %>"></div>

            <div class="container program-text">
              <% if (editMode) { %>
              <p class="ls-program-error<%= isLeft ? '' : ' text-end' %>" hidden>
                Vous devez garder au moins une étape au programme.
              </p>
              <div class="ls-program-actions">
                <button
                  type="button"
                  class="ls-program-remove"
                  data-remove-program="<%= i %>"
                  data-remove-loc="<%= location.id %>"
                  title="Supprimer cette étape"
                  aria-label="Supprimer cette étape"
                >&times;</button>
                <button
                  type="button"
                  class="ls-program-revert"
                  data-revert-program="<%= i %>"
                  data-revert-loc="<%= location.id %>"
                  title="Rétablir cette étape"
                  aria-label="Rétablir cette étape"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                    <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466"/>
                  </svg>
                </button>
              </div>
              <% } %>

              <div class="mx-2 row<%= isLeft ? '' : ' justify-content-end' %>">
                <div class="col-5">
                  <h4 class="<%= isLeft ? '' : 'text-end' %>"><%- slot(`${prefix}.title`) %></h4>
                  <% if (editMode || slotHasValue(`${prefix}.time`)) { %>
                  <p class="program-time <%= isLeft ? '' : 'text-end' %>"><%- slot(`${prefix}.time`) %></p>
                  <% } %>
                </div>
              </div>
              <div class="mx-2 row<%= isLeft ? '' : ' justify-content-end' %>">
                <div class="col-5">
                  <p class="<%= isLeft ? '' : 'text-end' %>">
                    <%- slot(`${prefix}.text`) %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% } %>

        <% if (editMode) { %>
        <%
          // The add affordance continues the dashed line and puts the + on it,
          // so the section still reads as one timeline while it is being
          // edited. It sits after every row in the DOM — the hidden rows take
          // no space, so it always lands directly under the last visible entry.
        %>
        <div class="row program-row ls-program-add" data-program-add="<%= location.id %>" style="position: relative">
          <div class="col">
            <div class="vertical-line-v2"></div>
            <div class="ls-program-add-inner">
              <button
                type="button"
                class="ls-program-add-btn"
                data-add-loc="<%= location.id %>"
                aria-label="Ajouter une étape"
              >+</button>
              <p class="ls-program-add-hint">Cliquez pour ajouter une étape</p>
            </div>
          </div>
        </div>
        <% } %>
      </div>
      <% }); %>
    </div>

    <div class="story-section ">
      <a class="anchor" id="story-anchor"></a>
      <div class="container pt-4 left-text my-3">
        <div class="row section-title">
          <div class="col text-center mb-sm-4">
            <h2 class="double-word"><%- slot('home.story.title') %></h2>

          </div>
        </div>

        <!-- Right img text -->

        <div class="row justify-content-evenly align-items-end mx-auto">
          <div class="col-md pb-4 pb-lg-0 col-lg-4">
            <p class="text-align-left mt-2 section-text">
              <%- slot('home.story.text1') %>
            </p>
          </div>
          <div class="col-lg-6 border-v d-flex justify-content-center">
            <img
              src="<%= imgSrc('home.story.image1') %>"
              data-img-slot="home.story.image1"
              class="img-fluid couple-img"
              alt=""
            />
          </div>

          <!-- Right img text -->

          <!-- left img text -->

          <div class="row  justify-content-evenly align-items-end mx-auto" >
          <div
            class="col-lg-6 d-flex justify-content-sm-center justify-content-lg-start border-v left order-2 order-sm-1"
          >
            <div style="position: relative; display: inline-block;">
              <img
                src="<%= imgSrc('home.story.image2') %>"
                data-img-slot="home.story.image2"
                class="img-fluid couple-img"
                alt=""
              />
            </div>
          </div>

          <div
            class="col-md  right col-lg-4 pb-4 pb-lg-0 order-1 order-sm-2"
          >
            <p class="text mt-2 section-text">
              <%- slot('home.story.text2') %>
            </p>
          </div>
        </div>

          
        </div>
      </div>

      <!-- Left Image text section -->
      
      <!-- Right img text -->
         
        <div class="container pb-5 left-text my-3">
          <div class="row justify-content-evenly align-items-end mx-auto">
            <div class="col-md  pb-4 pb-lg-0 col-lg-4">
              <p class="text-align-left mt-2 section-text">
                <%- slot('home.story.text3') %>
              </p>
            </div>
            <div class="col-lg-6 border-v d-flex justify-content-center">
              <img
                src="<%= imgSrc('home.story.image3') %>"
                data-img-slot="home.story.image3"
                class="img-fluid couple-img"
                alt=""
              />
            </div>
        </div>
      

    </div>

  </body>

  <%- include("footer.ejs") %>

  <script defer src="/js/register-toast.js"></script>
  <script defer src="/js/program-tabs.js"></script>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"
  ></script>

  <% if (typeof editMode !== 'undefined' && editMode) { %>
  <script defer src="/js/edit-mode.js"></script>
  <% } %>
</html>
