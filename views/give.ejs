<!DOCTYPE html>
<html lang="en">
  
<%- include("header.ejs") %>


  <!-- Styles -->
  <link rel="stylesheet" href="/styles/give.css" />
  <!-- Styles -->

  <body class="<%= typeof editMode !== 'undefined' && editMode ? 'ls-edit-mode' : '' %>">

    <% if (typeof editMode !== 'undefined' && editMode) { %>
    <%- include("edit-bar.ejs", { editPage: 'give', editPageLabel: 'Offrir' }) %>
    <% } %>

    <%- include('navbar.ejs') %>

    <%
      // give-container narrows Bootstrap's container and adds real side
      // padding, so the photo is not pushed against (or past) the right edge.
    %>
    <div class="container give-container my-4">
      <div class="row title my-4">
        <div class="col">
          <h2><%- slot('give.title') %></h2>
        </div>
      </div>
      <div class="d-flex flex-column flex-md-row justify-content-center">
        <%
          // give-text-col carries `min-width: 0`. Without it this flex item is
          // sized by its own content, so a longer intro widened the column and
          // pushed the photo out of the row instead of wrapping.
        %>
        <div class="d-flex flex-column justify-content-md-center give-text-col">
          <div class="row text justify-content-start">
            <div class="col-sm-12 col-md-8">
              <p class="">
                <%- slot('give.intro') %>
              </p>
            </div>
          </div>
          <div class="row options">
            <div class="col-sm-12 mb-4 col-md">
              <div class="container d-flex flex-column justify-content-center">
                <div
                  class="row d-flex justify-content-center justify-content-md-start gap-payment"
                >
                  <div
                    id="wave-btn"
                    class="col-8 col-md-4 rounded-3 px-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #20c8fe"
                  >
                    <img
                      class="me-2"
                      width="60"
                      src="https://images.sftcdn.net/images/t_app-icon-s/p/3d62c2ba-88f3-4973-87c1-1a156a52a1a6/1724688045/wave-mobile-money-logo"
                      alt=""
                    />
                    <p style="color: white; margin: 0; font-size: x-large">
                      Wave
                    </p>
                  </div>
                  <div
                    class="col-8 col-md-4 rounded-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #f0eeee"
                  >
                    <img
                      class="me-2 h-50"
                      height=""
                      width="60"
                      src="/img/PYPL.svg"
                      alt=""
                    />
                    <p style="color: black; margin: 0; font-size: x-large">
                      Paypal
                    </p>
                  </div>
                  <div
                    id="orange-money-btn"
                    class="col-8 col-md-4 rounded-3 px-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #fff6f6; min-height: 70px"
                  >
                    <img
                      class="me-2"
                      width="60"
                      src="https://1000logos.net/wp-content/uploads/2021/02/Orange-Money-emblem-500x228.png"
                      alt=""
                      height=""
                    />
                    <p
                      style="
                        color: black;
                        margin: 0;
                        text-align: center;
                        font-size: large;
                      "
                    >
                      Orange Money
                    </p>
                  </div>
                  <div
                    id="interac-btn"
                    class="col-8 col-md-4 py-2 rounded-3 px-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #fdb912"
                  >
                    <img
                      class="me-2"
                      width="60"
                      src="https://upload.wikimedia.org/wikipedia/commons/3/31/InteracLogo.svg"
                      alt=""
                    />
                    <p style="color: black; margin: 0; font-size: x-large">
                      Interac
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="row details">
            <div class="col-sm-12 col-md-8 my-4 payment-info col-md">
              <div
                id="wave"
                class="d-none container payment-container d-flex flex-column justify-content-evenly align-items-center"
              >
                <div class="row">
                  <div class="col">
                    <h3><%- slot('give.wave.title') %></h3>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Numéro de téléphone:</b> <%- slot('give.wave.phone') %></p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Nom:</b> <%- slot('give.wave.name') %></p>
                  </div>
                </div>
              </div>
              <div
                id="orange-money"
                class="d-none container payment-container d-flex flex-column justify-content-evenly align-items-center"
              >
                <div class="row">
                  <div class="col">
                    <h3><%- slot('give.orange.title') %></h3>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Numéro de téléphone:</b> <%- slot('give.orange.phone') %></p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Nom:</b> <%- slot('give.orange.name') %></p>
                  </div>
                </div>
              </div>
              <div
                id="interac"
                class="d-none container payment-container d-flex flex-column justify-content-evenly align-items-center"
              >
                <div class="row">
                  <div class="col">
                    <h3><%- slot('give.interac.title') %></h3>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Numéro de téléphone:</b> <%- slot('give.interac.phone') %></p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Adresse e-mail:</b> <%- slot('give.interac.email') %></p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Nom:</b> <%- slot('give.interac.name') %></p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="row px-4 px-md-0 img">
          <div
            class="col-sm-12 col-md  border-v main-img"
            data-img-slot="give.image"
            data-img-var="--ls-give-image"
            data-img-value="<%= imgSrc('give.image') %>"
            style="--ls-give-image: url('<%= imgSrc('give.image') %>')"
          ></div>
        </div>
      </div>
    </div>
  </body>

  <%- include("footer.ejs") %>

    <!-- JQuery CDN -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <!-- JQuery CDN -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"
  ></script>
  <script src="js/give.js"></script>

  <% if (typeof editMode !== 'undefined' && editMode) { %>
  <script defer src="/js/edit-mode.js"></script>
  <% } %>
</html>
