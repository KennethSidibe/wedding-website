    <div class="container my-4">
      <div class="row title my-4">
        <div class="col">
          <h2>Merci de ton geste</h2>
        </div>
      </div>
      <div class="d-flex flex-column flex-md-row justify-content-center">
        <div class="d-flex flex-column justify-content-md-center">
          <div class="row text justify-content-start">
            <div class="col-sm-12 col-md-8">
              <p class="">
                Pour nous faire une donation, vous pouvez utiliser l'un des
                moyens de paiement ci-dessous :
              </p>
            </div>
          </div>
          <div class="row options">
            <div class="col-sm-12 mb-4 col-md">
              <div class="container d-flex flex-column justify-content-center">
                <div
                  class="row d-flex justify-content-center justify-content-md-start gap-payment"
                >
                  <div
                    id="wave-btn"
                    class="col-8 col-md-4 rounded-3 px-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #20c8fe"
                  >
                    <img
                      class="me-2"
                      width="60"
                      src="https://images.sftcdn.net/images/t_app-icon-s/p/3d62c2ba-88f3-4973-87c1-1a156a52a1a6/1724688045/wave-mobile-money-logo"
                      alt=""
                    />
                    <p style="color: white; margin: 0; font-size: x-large">
                      Wave
                    </p>
                  </div>
                  <div
                    class="col-8 col-md-4 rounded-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #f0eeee"
                  >
                    <img
                      class="me-2 h-50"
                      height=""
                      width="60"
                      src="/img/PYPL.svg"
                      alt=""
                    />
                    <p style="color: black; margin: 0; font-size: x-large">
                      Paypal
                    </p>
                  </div>
                  <div
                    id="orange-money-btn"
                    class="col-8 col-md-4 rounded-3 px-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #fff6f6; min-height: 70px"
                  >
                    <img
                      class="me-2"
                      width="60"
                      src="https://1000logos.net/wp-content/uploads/2021/02/Orange-Money-emblem-500x228.png"
                      alt=""
                      height=""
                    />
                    <p
                      style="
                        color: black;
                        margin: 0;
                        text-align: center;
                        font-size: large;
                      "
                    >
                      Orange Money
                    </p>
                  </div>
                  <div
                    id="interac-btn"
                    class="col-8 col-md-4 py-2 rounded-3 px-3 d-flex flex-row justify-content-center align-items-center"
                    style="background-color: #fdb912"
                  >
                    <img
                      class="me-2"
                      width="60"
                      src="https://upload.wikimedia.org/wikipedia/commons/3/31/InteracLogo.svg"
                      alt=""
                    />
                    <p style="color: black; margin: 0; font-size: x-large">
                      Interac
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
