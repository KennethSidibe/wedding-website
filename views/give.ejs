                    <p><b>Adresse e-mail:</b> sheridan@test.com</p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <p><b>Nom:</b> Moussa Zombré</p>
                  </div>
                </div>
              </div>
            </div>
